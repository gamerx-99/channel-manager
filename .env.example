# hayhost local development variables.
# Copy this file to `.dev.vars` (read by `wrangler dev`) and fill in what you need.
# Staging and production read the same names as Worker secrets:
#   pnpm exec wrangler secret put <NAME> --env staging|production
# D1 (DB), R2 (MEDIA) and the booking rate limiter are bindings in wrangler.toml, not variables.

# Better Auth session signing secret. Required. Use a long random value.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public URL used in email links. Local dev: http://localhost:8787
PUBLIC_APP_URL=http://localhost:8787

# Transactional email through Resend. Without a key, no email is sent.
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# Social sign-in. Leave empty to hide that sign-in method.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# SlipOK. Each hotel adds its own key in settings; this 64-char hex key encrypts them at rest.
SLIPOK_ENCRYPTION_KEY=
# Platform account used for hayhost's own billing slips.
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
PLATFORM_PROMPTPAY_ID=

# Billing candidate APIs stay off unless set to "true".
BILLING_CANDIDATE_ENABLED=false

# Client feature flags (read at build time by Vite).
VITE_FEATURE_OTA_SYNC=
VITE_FEATURE_COMMUNICATIONS=
