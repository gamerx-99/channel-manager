# Channel Manager MVP environment variables
# Copy this file to .env and replace every placeholder with a real value.

# Supabase browser and server RLS credentials.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
CHANNEL_MANAGER_SUPABASE_URL=https://your-project-ref.supabase.co
CHANNEL_MANAGER_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only administrative credential. Never expose this in VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL connection used by migrations and opt-in integration tests.
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_POOLER_DB_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Enable only when a real disposable/test database is configured.
RUN_SUPABASE_INTEGRATION_TESTS=false

# Server configuration.
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Optional TM.30 approved template path. Relative paths resolve from the project root.
# TM30_TEMPLATE_PATH=server/assets/Template-InformAccom-ImportExcel.xls

# Optional Manus/OAuth configuration.
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=
# VITE_FRONTEND_FORGE_API_KEY=
# VITE_FRONTEND_FORGE_API_URL=
